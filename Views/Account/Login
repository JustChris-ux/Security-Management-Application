@model SecurityFirm.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход в системата";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <div class="auth-logo">
        <div class="auth-logo-icon">
            <i class="fas fa-shield-halved"></i>
        </div>
        <h1 class="auth-title">СекюрТийм</h1>
        <p class="auth-subtitle">Система за управление на охраната</p>
    </div>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div asp-validation-summary="ModelOnly"
             style="background:var(--danger-soft);border:1px solid #FECACA;border-radius:8px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:#991B1B;display:none"
             id="val-summary">
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <div style="position:relative">
                <i class="fas fa-envelope" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--text-muted)"></i>
                <input asp-for="Email" type="email" class="form-control"
                       placeholder="вашият@имейл.bg"
                       style="padding-left:38px" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="form-group">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <label asp-for="Password" class="form-label" style="margin:0"></label>
            </div>
            <div style="position:relative">
                <i class="fas fa-lock" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--text-muted)"></i>
                <input asp-for="Password" type="password" class="form-control"
                       placeholder="••••••••"
                       style="padding-left:38px;padding-right:42px"
                       id="password-input"
                       autocomplete="current-password" />
                <button type="button"
                        onclick="togglePassword()"
                        style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:4px"
                        id="toggle-pw-btn">
                    <i class="fas fa-eye" id="toggle-pw-icon"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="form-error"></span>
        </div>

        <div class="form-group" style="display:flex;align-items:center;gap:10px">
            <input asp-for="RememberMe" type="checkbox"
                   style="width:16px;height:16px;accent-color:var(--accent);cursor:pointer" />
            <label asp-for="RememberMe" class="form-label" style="margin:0;cursor:pointer;font-size:13px">Запомни ме</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-lg" style="margin-top:8px">
            <i class="fas fa-right-to-bracket"></i> Вход в системата
        </button>
    </form>

    <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--border);text-align:center">
        <p style="font-size:12px;color:var(--text-muted)">
            <i class="fas fa-shield-check" style="color:var(--success)"></i>
            Защитена връзка · Всички данни са криптирани
        </p>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script>
function togglePassword() {
    const input = document.getElementById('password-input');
    const icon  = document.getElementById('toggle-pw-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}

// Show validation summary if has errors
document.addEventListener('DOMContentLoaded', function () {
    const vs = document.querySelector('.validation-summary-errors ul');
    if (vs && vs.children.length > 0) {
        document.getElementById('val-summary').style.display = 'block';
    }
});
</script>
}
