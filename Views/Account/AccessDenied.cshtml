@{
    ViewData["Title"] = "Отказан достъп";
}

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center">
    <div style="width:80px;height:80px;background:var(--danger-soft);border-radius:20px;display:flex;align-items:center;justify-content:center;margin-bottom:24px">
        <i class="fas fa-shield-xmark" style="font-size:36px;color:var(--danger)"></i>
    </div>
    <h1 style="font-size:28px;font-weight:700;color:var(--text-primary);margin-bottom:8px">Отказан достъп</h1>
    <p style="color:var(--text-secondary);font-size:15px;max-width:400px;line-height:1.6;margin-bottom:24px">
        Нямате необходимите права за достъп до тази страница. Моля, свържете се с администратора.
    </p>
    <div class="d-flex gap-10">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-gauge-high"></i> Към таблото
        </a>
        <button onclick="history.back()" class="btn btn-ghost">
            <i class="fas fa-arrow-left"></i> Назад
        </button>
    </div>
</div>
